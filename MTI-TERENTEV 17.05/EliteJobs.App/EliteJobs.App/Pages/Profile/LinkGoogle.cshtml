@page
@model EliteJobs.App.Pages.Profile.LinkGoogleModel
@{
    ViewData["Title"] = "Link Google Account";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card" style="border: 1px solid var(--accent);">
                <div class="card-header text-center">
                    <h3 style="color: var(--accent-gold); letter-spacing: 2px;">LINK GOOGLE</h3>
                </div>
                <div class="card-body text-center">
                    @if (Model.IsLinked)
                    {
                        <div class="alert alert-success">
                            Google account is linked!
                        </div>
                        <p style="color: var(--text-secondary);">You can now sign in with Google.</p>
                    }
                    else
                    {
                        <p style="color: var(--text-secondary); margin-bottom: 20px;">
                            Link your Google account to sign in without password.
                        </p>
                        <form asp-page-handler="Link" method="post">
                            <button type="submit" class="btn w-100 py-2" style="background: #fff; color: #333; font-size: 1rem;">
                                🅶 Link Google Account
                            </button>
                        </form>
                    }

                    <div class="mt-3">
                        <a asp-page="/Profile/Worker" class="btn btn-secondary btn-sm">Back to profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>