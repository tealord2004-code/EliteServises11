@page "{id:int?}"
@model EliteJobs.App.Pages.Profile.ResumeEditModel
@{
    ViewData["Title"] = Model.IsNew ? "Создать резюме" : "Редактировать резюме";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@(Model.IsNew ? "Новое резюме" : "Редактирование")</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Желаемая должность *</label>
                            <input asp-for="Input.DesiredPosition" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Зарплата</label>
                                <input asp-for="Input.DesiredSalary" class="form-control" placeholder="300 000 ₽" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Город</label>
                                <input asp-for="Input.City" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Тип занятости</label>
                                <select asp-for="Input.EmploymentType" class="form-select">
                                    <option value="">Выберите...</option>
                                    <option value="Полная">Полная</option>
                                    <option value="Частичная">Частичная</option>
                                    <option value="Проектная">Проектная</option>
                                    <option value="Стажировка">Стажировка</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">График работы</label>
                                <select asp-for="Input.WorkSchedule" class="form-select">
                                    <option value="">Выберите...</option>
                                    <option value="5/2">5/2</option>
                                    <option value="2/2">2/2</option>
                                    <option value="Гибкий">Гибкий</option>
                                    <option value="Удалённый">Удалённый</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ключевые навыки</label>
                            <input asp-for="Input.Skills" class="form-control" placeholder="C#, .NET, SQL (через запятую)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Опыт работы</label>
                            <textarea asp-for="Input.Experience" class="form-control" rows="4" maxlength="5000"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Образование</label>
                            <textarea asp-for="Input.Education" class="form-control" rows="2" maxlength="2000"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Языки</label>
                            <input asp-for="Input.Languages" class="form-control" placeholder="Английский B2, Немецкий A1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">О себе</label>
                            <textarea asp-for="Input.About" class="form-control" rows="3" maxlength="5000"></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input asp-for="Input.ReadyForRemote" class="form-check-input" checked />
                                    <label class="form-check-label">Удалённая работа</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input asp-for="Input.ReadyToRelocate" class="form-check-input" />
                                    <label class="form-check-label">Готов к переезду</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input asp-for="Input.HasCar" class="form-check-input" />
                                    <label class="form-check-label">Есть автомобиль</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Водительские права</label>
                            <select asp-for="Input.DrivingLicense" class="form-select">
                                <option value="">Нет</option>
                                <option value="B">B</option>
                                <option value="B, C">B, C</option>
                                <option value="B, C, D">B, C, D</option>
                            </select>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.IsActive" class="form-check-input" checked />
                            <label class="form-check-label">Активно</label>
                        </div>

                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-page="/Profile/Worker" class="btn btn-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script src="~/js/autocomplete.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                initCityAutocomplete('input[name="Input.City"]');
                initProfessionAutocomplete('input[name="Input.DesiredPosition"]');
            });
        </script>
    }
</div>