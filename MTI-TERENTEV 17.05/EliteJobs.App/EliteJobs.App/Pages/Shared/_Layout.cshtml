@using Microsoft.AspNetCore.Identity
@using EliteJobs.App.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ELITE SERVICES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body {
            background: #0a0a0a !important;
            color: #d0d0d0 !important;
            font-family: 'Inter', 'Segoe UI', sans-serif !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index" style="font-weight:700;letter-spacing:3px;">ELITE</a>
                <a asp-page="/Account/Support" style="color: #666;">Поддержка</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Услуги</a></li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Chat/List">Чаты</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Admin/Dashboard">Панель</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/Admin/Competitors">Аналитика</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-page="/Create">✦ Разместить</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    @user?.FirstName
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger">Админ</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Profile/Worker">Профиль</a></li>
                                    <li><a class="dropdown-item" asp-page="/Profile/AddRole">Роли</a></li>
                                    <li><a class="dropdown-item" asp-page="/Profile/Upgrade">Тариф</a></li>
                                    <li><a class="dropdown-item" asp-page="/Account/Support">Поддержка</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-page="/Account/Logout">Выйти</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Регистрация</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Войти</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="min-height: calc(100vh - 100px);">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer py-3">
        <div class="container text-center">
            <span style="color: #666;">&copy; 2024 ELITE SERVICES</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>