@page
@model EliteJobs.App.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Чат";
}

<div class="container mt-4">
    <h2>Чат</h2>

    @if (Model.ChatRoom == null)
    {
        <div class="alert alert-info">
            Начните общение, отправив первое сообщение.
        </div>
    }

    <div class="card">
        <div class="card-header">
            <strong>@Model.OtherUser?.FirstName @Model.OtherUser?.LastName</strong>
            @if (Model.OtherUser?.Company != null)
            {
                <span class="text-muted">- @Model.OtherUser.Company</span>
            }
        </div>
        <div class="card-body" style="height: 400px; overflow-y: auto;" id="messagesContainer">
            <div id="messagesList">
                @if (Model.Messages != null && Model.Messages.Any())
                {
                    @foreach (var message in Model.Messages)
                    {
                        var isMine = message.SenderId == Model.CurrentUserId;
                        <div class="mb-2 @(isMine ? "text-end" : "")">
                            <div class="d-inline-block p-2 rounded @(isMine ? "bg-primary text-white" : "bg-light")"
                                 style="max-width: 70%;">
                                <small class="text-muted">@message.SentAt.ToString("HH:mm")</small>
                                <p class="mb-0">@message.DecryptedContent</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">Нет сообщений. Напишите первое!</p>
                }
            </div>
        </div>
        <div class="card-footer">
            <form method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="otherUserId" value="@Model.OtherUserId" />
                <input type="text" name="messageContent" class="form-control"
                       placeholder="Введите сообщение..." required maxlength="5000"
                       onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); this.form.submit(); }" />
                <button type="submit" class="btn btn-primary">Отправить</button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-secondary">Назад</a>
    </div>
</div>