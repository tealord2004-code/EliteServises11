@page "{serviceId:int}"
@model EliteJobs.App.Pages.Employer.ApplicationsModel
@{
    ViewData["Title"] = "Заказы на услугу";
}

<div class="container mt-4">
    <h2>Заказы</h2>

    @if (Model.Service != null)
    {
        <div class="mb-3">
            <h4>@Model.Service.Title</h4>
        </div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info">Пока нет заказов.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var order in Model.Orders)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5>@order.Customer?.FirstName @order.Customer?.LastName</h5>
                            <p class="mb-1">@order.RequestedDate.ToString("dd.MM.yyyy HH:mm")</p>
                            <p><strong>Статус:</strong> @order.Status</p>
                            @if (!string.IsNullOrEmpty(order.Message))
                            {
                                <div class="mt-2 p-2 bg-light rounded">
                                    <p class="mb-0">@order.Message</p>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-page="/Chat/Index" asp-route-userId="@order.CustomerId" class="btn btn-primary btn-sm">Чат</a>
                            <form method="post" asp-page-handler="Accept" asp-route-applicationId="@order.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-success btn-sm">Принять</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-applicationId="@order.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm">Отклонить</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-page="/Details" asp-route-id="@Model.ServiceId" class="btn btn-secondary">← Назад</a>
    </div>
</div>