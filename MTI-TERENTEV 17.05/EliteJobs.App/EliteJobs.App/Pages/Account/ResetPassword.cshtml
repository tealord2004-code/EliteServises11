@page
@model EliteJobs.App.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card" style="border: 1px solid var(--accent);">
                <div class="card-header text-center" style="background: linear-gradient(135deg, #0a0000, #1a0000); border-bottom: 1px solid var(--accent);">
                    <h3 style="color: var(--accent-gold); letter-spacing: 3px; font-weight: 300;">NEW PASSWORD</h3>
                </div>
                <div class="card-body p-4">
                    @if (Model.PasswordReset)
                    {
                        <div class="alert alert-success">Password changed! <a asp-page="/Account/Login">Sign in</a></div>
                    }
                    else
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Input.Token" />
                            <input type="hidden" asp-for="Input.Email" />
                            <div class="mb-3">
                                <label class="form-label">New Password</label>
                                <input asp-for="Input.Password" class="form-control" type="password" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Confirm Password</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Reset Password</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>