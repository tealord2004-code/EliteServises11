@page
@model EliteJobs.App.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card" style="border: 1px solid var(--accent);">
                <div class="card-header text-center" style="background: linear-gradient(135deg, #0a0000, #1a0000); border-bottom: 1px solid var(--accent);">
                    <h3 style="color: var(--accent-gold); letter-spacing: 3px; font-weight: 300;">RESET PASSWORD</h3>
                </div>
                <div class="card-body p-4">
                    @if (Model.EmailSent)
                    {
                        <div class="alert alert-success">If the email exists, a reset link has been sent.</div>
                    }
                    else
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" type="email" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                        </form>
                    }
                    <div class="mt-3 text-center">
                        <a asp-page="/Account/Login" style="color: var(--accent-gold);">Back to Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>