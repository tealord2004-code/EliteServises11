@page
@model EliteJobs.App.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card" style="border: 1px solid var(--accent);">
                <div class="card-header text-center" style="background: linear-gradient(135deg, #0a0000 0%, #1a0000 100%); border-bottom: 1px solid var(--accent);">
                    <h3 class="mb-0" style="color: var(--accent-gold); letter-spacing: 3px; font-weight: 300;">РЕГИСТРАЦИЯ</h3>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post" id="registerForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="recaptchaToken" id="recaptchaToken" />

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Фамилия *</label>
                                <input name="firstName" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Имя *</label>
                                <input name="lastName" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Отчество</label>
                                <input name="middleName" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input name="email" class="form-control" type="email" required />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Пароль *</label>
                                <input name="password" class="form-control" type="password" required minlength="8" />
                                <small style="color: var(--text-muted);">Минимум 8 символов, заглавная, цифра, спецсимвол</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Подтверждение *</label>
                                <input name="confirmPassword" class="form-control" type="password" required />
                            </div>
                        </div>

                        <hr style="border-color: var(--border);" />
                        <p style="color: var(--accent-gold); text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem;">Я хочу:</p>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="card p-3 mb-2 role-card selected" data-role="customer-individual" style="cursor: pointer; border: 2px solid var(--accent); box-shadow: 0 0 20px rgba(139, 0, 0, 0.5);">
                                    <h5 style="color: var(--text-primary);">🔍 Заказчик (физ.)</h5>
                                    <small style="color: var(--text-secondary);">Искать и заказывать услуги</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card p-3 mb-2 role-card" data-role="provider-individual" style="cursor: pointer; border: 2px solid var(--border);">
                                    <h5 style="color: var(--text-primary);">💼 Подрядчик (физ.)</h5>
                                    <small style="color: var(--text-secondary);">Оказывать услуги как специалист</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card p-3 mb-2 role-card" data-role="customer-company" style="cursor: pointer; border: 2px solid var(--border);">
                                    <h5 style="color: var(--text-primary);">🏢 Заказчик (юр.)</h5>
                                    <small style="color: var(--text-secondary);">Компания ищет услуги</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card p-3 mb-2 role-card" data-role="provider-company" style="cursor: pointer; border: 2px solid var(--border);">
                                    <h5 style="color: var(--text-primary);">🏭 Подрядчик (юр.)</h5>
                                    <small style="color: var(--text-secondary);">Компания оказывает услуги</small>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="role" id="selectedRole" value="customer-individual" />

                        <div id="companyNameField" class="mb-3" style="display:none;">
                            <label class="form-label">Название компании</label>
                            <input name="company" class="form-control" placeholder="ООО Рога и Копыта" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2" style="font-size: 1.1rem; letter-spacing: 2px;">
                            ✦ ЗАРЕГИСТРИРОВАТЬСЯ
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <p style="color: var(--text-muted);">Уже есть аккаунт? <a asp-page="/Account/Login" style="color: var(--accent-gold);">Войти</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js?render=@Model.RecaptchaSiteKey"></script>
    <script>
        document.querySelectorAll('.role-card').forEach(card => {
            card.addEventListener('click', function() {
                document.querySelectorAll('.role-card').forEach(c => { c.style.border = '2px solid var(--border)'; c.style.boxShadow = 'none'; });
                this.style.border = '2px solid var(--accent)'; this.style.boxShadow = '0 0 20px rgba(139, 0, 0, 0.5)';
                document.getElementById('selectedRole').value = this.dataset.role;
                document.getElementById('companyNameField').style.display = this.dataset.role.includes('company') ? 'block' : 'none';
            });
        });

        document.getElementById('registerForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var form = this;
            grecaptcha.ready(function() {
                grecaptcha.execute('@Model.RecaptchaSiteKey', { action: 'register' }).then(function(token) {
                    document.getElementById('recaptchaToken').value = token;
                    form.submit();
                });
            });
        });
    </script>
}