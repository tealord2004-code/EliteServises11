@page
@model EliteJobs.App.Pages.Account.ExternalLoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Redirecting to Google...</title>
    <meta http-equiv="refresh" content="0;url=@Model.RedirectUrl" />
</head>
<body style="background:#0a0a0a;color:#d0d0d0;text-align:center;padding-top:100px;font-family:sans-serif;">
    <p>Redirecting to Google Sign-In...</p>
    <p style="color:#666;">If nothing happens, <a href="@Model.RedirectUrl" style="color:#c9a84c;">click here</a>.</p>
</body>
</html>