@page
@model EliteJobs.App.Pages.Account.AdminLoginModel
@{
    ViewData["Title"] = "Admin Access";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card" style="border: 2px solid var(--accent);">
                <div class="card-header text-center" style="background: #000;">
                    <h3 style="color: var(--accent); letter-spacing: 4px;">🔒 ADMIN</h3>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Admin Email</label>
                            <input name="email" class="form-control" type="email" required
                                   value="admin@elitejobs.ru" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Admin Password</label>
                            <input name="password" class="form-control" type="password" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Security Key</label>
                            <input name="accessKey" class="form-control" type="text" required
                                   placeholder="Enter admin security key" />
                            <small style="color: var(--text-muted);">Separate key required for admin access</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2" style="font-size: 1.1rem;">
                            🔒 Admin Sign In
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-page="/Account/Login" style="color: var(--text-muted);">← Regular Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>